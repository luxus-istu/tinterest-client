# Backend API URL (used in production builds)
NEXT_PUBLIC_API_URL="https://localhost:8443"

# Optional STOMP WebSocket endpoint. Defaults to NEXT_PUBLIC_API_URL + /ws.
NEXT_PUBLIC_WS_URL="wss://localhost:8443/ws"

# In development, requests are proxied via /api/proxy to bypass CORS.
# The proxy target is read from NEXT_PUBLIC_API_URL above.

# Yandex captcha sitekey
NEXT_PUBLIC_CAPTCHA_SITEKEY=""
